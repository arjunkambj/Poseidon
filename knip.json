{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    "types": "off",
    "nsTypes": "off"
  },
  "tags": ["-@public"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/*.mjs"]
    },
    "apps/desktop": {
      "entry": [
        "src/main/index.ts!",
        "src/preload/index.ts!",
        "electron-builder.config.cjs",
        "scripts/*.mjs"
      ],
      // tsx is resolved through the server package (it is a server devDep).
      "ignoreDependencies": ["@poseidon/contracts", "tsx"]
    },
    "apps/site": {
      "entry": ["src/entry-server.tsx!", "scripts/*.mjs"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "apps/web": {
      "entry": ["src/routes/**/*.tsx"],
      "ignoreIssues": {
        "src/components/mode-toggle.tsx": ["files"],
        "src/lib/shortcuts.tsx": ["exports"]
      },
      "ignoreDependencies": ["@poseidon/config", "clsx", "postcss", "tailwind-merge", "tailwindcss"]
    },
    "packages/client-runtime": {
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true,
      "ignoreDependencies": ["@effect/atom-react"]
    },
    "packages/connector-cmd": {
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true,
      // Spawned via execFileSync — a system tool, not an npm dependency.
      "ignoreBinaries": ["pgrep"]
    },
    "packages/connector-claude": {
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true,
      // The recorders under test/ are run by hand against the real CLI (they
      // read the operator's account), so nothing imports them.
      "entry": ["test/*.test.ts"],
      // Spawned via execFile — a system tool, not an npm dependency.
      "ignoreBinaries": ["pgrep"]
    },
    "packages/connector-codex": {
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true,
      // The recorders under test/ are run by hand against the real CLI (they
      // read the operator's account), so nothing imports them.
      "entry": ["test/*.test.ts"],
      // Spawned via execFile — a system tool, not an npm dependency.
      "ignoreBinaries": ["pgrep"]
    },
    "packages/connector-sdk": {
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true
    },
    "packages/contracts": {
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true,
      "ignoreIssues": {
        "src/ids.ts": ["exports"]
      }
    },
    "packages/shared": {
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true
    },
    "packages/ui": {
      // Kept for the shadcn CLI (components.json iconLibrary); the app renders
      // @honeyicons/react.
      "ignoreDependencies": ["@hugeicons/core-free-icons", "@hugeicons/react"]
    },
    "packages/testkit": {
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true,
      // The recorders are run by hand against the real CLI (they spend the
      // operator's plan), so nothing imports them — they are entry points.
      "entry": ["src/**/*.ts", "scripts/*.mjs", "bin/*.mjs"]
    }
  }
}
