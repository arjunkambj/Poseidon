{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts --dev",
    "build": "esbuild src/main.ts --bundle --platform=node --format=cjs --target=node22 --outfile=out/main.cjs --external:@lydell/node-pty --define:import.meta.url=__importMetaUrl \"--banner:js='use strict'; const __importMetaUrl = require('node:url').pathToFileURL(__filename).href;\"",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@poseidon/connector-claude": "workspace:*",
    "@poseidon/connector-cmd": "workspace:*",
    "@poseidon/connector-codex": "workspace:*",
    "@poseidon/connector-sdk": "workspace:*",
    "@poseidon/contracts": "workspace:*",
    "@poseidon/shared": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@poseidon/client-runtime": "workspace:*",
    "@poseidon/config": "workspace:*",
    "@poseidon/testkit": "workspace:*",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
